# =============================================================================
# RAILWAY ENVIRONMENT VARIABLES — copy these into each Railway service's
# "Variables" tab. Shared vars (DB, Redis, etc.) apply to all backend services
# (api, worker, beat). Frontend-only vars apply to web/admin/space.
# =============================================================================

# -----------------------------------------------------------------------------
# SHARED — api, worker, beat, live
# -----------------------------------------------------------------------------

# Django secret key — generate with: python -c "import secrets; print(secrets.token_hex(50))"
SECRET_KEY=

# Set to 0 in production
DEBUG=0

# Comma-separated Railway-assigned public domains for all services
CORS_ALLOWED_ORIGINS=https://your-web.up.railway.app,https://your-admin.up.railway.app,https://your-space.up.railway.app

# PostgreSQL — Railway provides this automatically when you add the Postgres plugin
DATABASE_URL=

# Redis — Railway provides this automatically when you add the Redis plugin
REDIS_URL=

# RabbitMQ — Railway provides this when you add the RabbitMQ plugin
AMQP_URL=

# S3-compatible storage (use Supabase Storage, AWS S3, or Backblaze B2)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=uploads
AWS_S3_ENDPOINT_URL=
# Set to 1 if your S3 endpoint uses HTTPS
MINIO_ENDPOINT_SSL=1

# Max upload file size in bytes (default 5MB)
FILE_SIZE_LIMIT=5242880

# Signed URL expiry in seconds
SIGNED_URL_EXPIRATION=3600

# Number of Gunicorn workers (Railway starter: 2 is fine)
GUNICORN_WORKERS=2

# Public URL of the web frontend
WEB_URL=https://your-web.up.railway.app

# Rate limiting (adjust as needed)
API_KEY_RATE_LIMIT=60/minute
IP_RATE_LIMIT=100/minute

# Org email domain whitelist (leave empty to allow all domains)
ALLOWED_EMAIL_DOMAINS=arbisoft.com,pressingly.net

# Days before hard-deleting soft-deleted records
HARD_DELETE_AFTER_DAYS=60

# -----------------------------------------------------------------------------
# API SERVICE ONLY
# -----------------------------------------------------------------------------
ADMIN_BASE_URL=https://your-admin.up.railway.app
ADMIN_BASE_PATH=/god-mode
SPACE_BASE_URL=https://your-space.up.railway.app
SPACE_BASE_PATH=/spaces
APP_BASE_URL=https://your-web.up.railway.app
APP_BASE_PATH=
LIVE_BASE_URL=https://your-live.up.railway.app
LIVE_BASE_PATH=/live

# -----------------------------------------------------------------------------
# LIVE SERVICE ONLY
# -----------------------------------------------------------------------------
PORT=3000
API_BASE_URL=https://your-api.up.railway.app
# Secret shared between API and Live for internal auth
LIVE_SERVER_SECRET_KEY=

# -----------------------------------------------------------------------------
# WEB / ADMIN / SPACE FRONTENDS (build-time args, set in Railway Variables)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=https://your-api.up.railway.app
VITE_WEB_BASE_URL=https://your-web.up.railway.app
VITE_ADMIN_BASE_URL=https://your-admin.up.railway.app
VITE_ADMIN_BASE_PATH=/god-mode
VITE_SPACE_BASE_URL=https://your-space.up.railway.app
VITE_SPACE_BASE_PATH=/spaces
VITE_LIVE_BASE_URL=https://your-live.up.railway.app
VITE_LIVE_BASE_PATH=/live
